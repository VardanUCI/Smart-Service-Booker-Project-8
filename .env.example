# ─── Supabase (Required) ────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project → Settings → API
#
# IMPORTANT for Vercel deployment:
#   1. Add both values in: Vercel Dashboard → Project → Settings → Environment Variables
#   2. Redeploy after saving them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Demo / Dev Accounts (Optional) ─────────────────────────────────────────
# Set to "true" to enable the built-in demo accounts:
#   user@demo.local     / DemoUser123!
#   business@demo.local / DemoBusiness123!
#
# NOTE: NODE_ENV is always "production" on Vercel (including preview deployments),
# so this flag is the ONLY way to enable demo accounts on Vercel.
# Recommended: enable only for Preview environments, never for Production.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# ─── Supabase Auth configuration (done in Supabase dashboard, not here) ──────
# After creating your Supabase project, complete these steps in the dashboard:
#
# 1. Authentication → URL Configuration
#    - Site URL:      https://your-app.vercel.app
#    - Redirect URLs: https://your-app.vercel.app/** (add wildcard for previews: https://*.vercel.app/**)
#
# 2. Authentication → Providers → Email
#    - "Confirm email" toggle: ON  (recommended for production)
#    - To skip verification during development: toggle it OFF temporarily
#
# 3. Authentication → SMTP Settings  (avoids the 3 emails/hour free-tier cap)
#    - Enable custom SMTP and add credentials from Resend, SendGrid, or Mailgun
#
# 4. SQL Editor → run supabase/schema.sql, then supabase/migrations/ in order (001→006)
#    or use the CLI: supabase db push
